# =============================================================================
# SWAY CONFIGURATION (MIGRATED FROM NIRI)
# =============================================================================

# Define main modifier key (Super/Windows)
set $mod Mod4

# --- Hardware Inputs ---
input * {
    events disabled
}

input "48879:57005:Touch_passthrough" {
    events enabled
}
input "48879:57005:Pen_passthrough" {
    events enabled
}
input "48879:57005:Keyboard_passthrough" {
    events enabled
}
input "48879:57005:Mouse_passthrough" {
    events enabled
}
input "48879:57005:Mouse_passthrough_(absolute)" {
    events enabled
}

# Niri's max-scroll-amount="0%" corresponds to classic focus-follows-mouse
focus_follows_mouse yes

# --- Outputs (Monitors) ---
output HEADLESS-1 mode 2560x1440@60Hz

# --- Visual Styling (Matching your Niri Colors & Gaps) ---
gaps inner 8
gaps outer 0

# Client styling boundaries matching your active/inactive hex colors
# Format: class client.variant border background text indicator child_border
client.focused          #ffc87f #ffc87f #000000 #7fc8ff #ffc87f
client.focused_inactive #505050 #505050 #ffffff #505050 #505050
client.unfocused        #505050 #505050 #ffffff #505050 #505050
client.urgent           #9b0000 #9b0000 #ffffff #9b0000 #9b0000

# Border setup
default_border pixel 4
default_floating_border pixel 4
hide_edge_borders none

# Note: Sway does not natively support rounded window geometry corners or 
# compositor-level box shadows out of the box without downstream patching (e.g., sway-fx).

# --- Core Environments & Shell Initialization ---
exec qs -c ~/.config/quickshell/noctalia-shell
exec ghostty

# Screen capture path configuration
# Note: Sway uses external utilities (grim/slurp) for capturing; this variable configures the fallback layout string 
set $screenshot_path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

# Allow Noctalia panel mechanics to stay un-tiled
for_window [app_id="quickshell"] floating enable, border none, sticky enable

# =============================================================================
# KEYBINDINGS
# =============================================================================

# System commands
bindsym $mod+Shift+slash exec swaymsg -t get_inputs
bindsym $mod+Return exec ghostty -e nu
bindsym $mod+d exec qs -c noctalia-shell ipc call launcher toggle
bindsym Super+Alt+l exec qs -c noctalia-shell ipc call lockScreen lock
bindsym $mod+b exec brave
bindsym Super+Alt+s exec pkill orca || exec orca

# Multimedia Controls (Inhibitor/Lock safe overrides)
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioStop exec playerctl stop
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86MonBrightnessUp exec brightnessctl --class=backlight set +10%
bindsym --locked XF86MonBrightnessDown exec brightnessctl --class=backlight set 10%-

# Basic Window Operations
bindsym $mod+q kill
bindsym $mod+v floating toggle
bindsym $mod+Shift+v focus mode_toggle

# Navigation Rules (remapped from columns/windows to Sway's directional splits)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Moving Windows
bindsym $mod+Ctrl+Left move left
bindsym $mod+Ctrl+Down move down
bindsym $mod+Ctrl+Up move up
bindsym $mod+Ctrl+Right move right

bindsym $mod+Ctrl+h move left
bindsym $mod+Ctrl+j move down
bindsym $mod+Ctrl+k move up
bindsym $mod+Ctrl+l move right

# Monitor Focus Management
bindsym $mod+Shift+Left focus output left
bindsym $mod+Shift+Down focus output down
bindsym $mod+Shift+Up focus output up
bindsym $mod+Shift+Right focus output right
bindsym $mod+Comma focus output left
bindsym $mod+Period focus output right

# Moving Containers Between Monitors
bindsym $mod+Shift+Ctrl+Left move container to output left
bindsym $mod+Shift+Ctrl+Down move container to output down
bindsym $mod+Shift+Ctrl+Up move container to output up
bindsym $mod+Shift+Ctrl+Right move container to output right
bindsym $mod+Shift+Ctrl+Comma move container to output left
bindsym $mod+Shift+Ctrl+Period move container to output right

# Workspace Navigation
bindsym $mod+Page_Down workspace next
bindsym $mod+Page_Up workspace prev
bindsym $mod+n workspace next
bindsym $mod+p workspace prev

# Moving containers between workspaces sequentially
bindsym $mod+Ctrl+Page_Down move container to workspace next
bindsym $mod+Ctrl+Page_Up move container to workspace prev
bindsym $mod+Ctrl+n move container to workspace next
bindsym $mod+Ctrl+p move container to workspace prev

# Discrete Numerical Workspace Mapping
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4
bindsym $mod+Ctrl+5 move container to workspace number 5
bindsym $mod+Ctrl+6 move container to workspace number 6
bindsym $mod+Ctrl+7 move container to workspace number 7
bindsym $mod+Ctrl+8 move container to workspace number 8
bindsym $mod+Ctrl+9 move container to workspace number 9

# Niri Column layouts mapped to explicit spatial splits sizing adjustments
bindsym $mod+BracketLeft splith
bindsym $mod+BracketRight splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+w layout tabbed

# Continuous sizing mechanics 
bindsym $mod+Minus resize shrink width 10 px or 10 ppt
bindsym $mod+Equal resize grow width 10 px or 10 ppt
bindsym $mod+Shift+Minus resize shrink height 10 px or 10 ppt
bindsym $mod+Shift+Equal resize grow height 10 px or 10 ppt

# Screenshot Mechanics (Maps directly using grim tools)
bindsym Print exec grim $screenshot_path
bindsym Ctrl+Print exec grim -o $(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name') $screenshot_path
bindsym Alt+Print exec grim -g "$(swaymsg -t get_tree | jq -j '.. | select(.type? == "con" and .focused == true) | "\(.rect.x),\(.rect.y) \(.rect.width)x\(.rect.height)"')" $screenshot_path

# Session Control
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'
bindsym Ctrl+Alt+Delete exec swaynag -t warning -m 'Exit Sway?' -B 'Yes' 'swaymsg exit'
